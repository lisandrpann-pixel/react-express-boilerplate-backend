# Значения по умолчанию для разработки. Файл попадает в git,
# поэтому сюда нельзя класть секреты: пароли, токены, ключи.
# Локальные переопределения — в .env, он подгружается последним и имеет приоритет.
# В production npm start не читает ни один env-файл: переменные приходят
# из окружения (docker, systemd), поэтому LOG_FILE там пустой и логи идут в stdout.

PORT=3000
LOG_LEVEL=info

# Ротация логов в файле. Размер пишется как 10m, 1g, 500k
LOG_FILE=logs/app.log
LOG_SIZE=10m

# Когда ротировать по времени: daily, hourly
LOG_FREQUENCY=daily